    {
      "parameters": {
        "jsCode": "// Combinar todos los resúmenes con TÍTULO REAL del RSS\nconst items = $input.all();\n\nlet htmlContent = `\n<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n  <h1 style=\"color: #333; border-bottom: 3px solid #4CAF50; padding-bottom: 10px;\">\n    📰 Últimas 5 Noticias Tech - ${new Date().toLocaleDateString('es-AR')}\n  </h1>\n  <br>\n`;\n\nitems.forEach((item, index) => {\n  // Obtener datos del ITEM ORIGINAL del RSS (antes de la IA)\n  const inputData = $item(index).$node[\"RSS Read\"].json;\n  \n  // Extraer título y link del RSS original\n  const titulo = inputData.title || `Artículo ${index + 1}`;\n  const link = inputData.link || inputData.url || '#';\n  \n  // Extraer el resumen generado por la IA\n  const resumen = item.json.content.parts[0].text;\n  \n  htmlContent += `\n    <div style=\"margin-bottom: 25px; padding: 20px; background: #f9f9f9; border-left: 4px solid #4CAF50; border-radius: 5px;\">\n      <h3 style=\"color: #2c3e50; margin-top: 0;\">\n        ${index + 1}. ${titulo}\n      </h3>\n      <p style=\"color: #555; line-height: 1.6; margin: 10px 0;\">\n        ${resumen}\n      </p>\n      <a href=\"${link}\" style=\"color: #4CAF50; text-decoration: none; font-size: 14px;\" target=\"_blank\">\n        Leer artículo completo →\n      </a>\n    </div>\n  `;\n});\n\nreturn [{ json: { emailContent: htmlContent } }];"
      },
